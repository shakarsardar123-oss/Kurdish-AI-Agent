# HAMAUMIN development configuration
# Database variables are provisioned by Replit in the development environment.
DATABASE_URL=

# Clerk Auth (provisioned by Replit's Auth pane)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# AI provider (the key stays server-side; never expose OPENAI_API_KEY in browser code)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional live web search provider
BRAVE_SEARCH_API_KEY=

# Local workflow values (Replit supplies these automatically)
PORT=8080
BASE_PATH=/